# 流量监控配置示例
# 复制为 config.conf 后修改，或直接运行脚本交互配置：
#   ./traffic-monitor.sh --setup

INTERFACE="eth0"
DAILY_LIMIT_GB="100"
MONTHLY_LIMIT_GB="0"
CHECK_INTERVAL_SEC="300"
TG_BOT_TOKEN=""
TG_CHAT_ID=""
TG_ENABLED="false"
ALERT_THRESHOLDS="50,80,90,95,100"
ALERT_COOLDOWN_MIN="60"
COUNT_MODE="total"
EXCLUDE_LO="true"
LOG_MAX_LINES="2000"
TIMEZONE=""
HOSTNAME_TAG="server"
